# Leave VITE_API_URL unset for local development — Vite's dev server proxies
# /api requests to http://localhost:5000 automatically (see vite.config.js).
# Only set this when building for a deployed environment, and make sure it
# ends in /api, e.g. https://your-backend.onrender.com/api
VITE_API_URL=

# Set to "true" only for local dev/demo builds — pre-fills the login form
# with the seeded admin credentials so evaluators can log in without typing
# anything. Leave unset (or "false") for any real deployment: a pre-filled
# admin password on a live login page is a real security hole.
VITE_DEMO_MODE=false
