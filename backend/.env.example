PORT=5000
# Neon connection string — get it from your Neon project dashboard (Connection Details).
# Use the "pooled connection" string ending in ?sslmode=require for serverless-friendly usage.
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/medtrack?sslmode=require
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Resend (resend.com) — used to email suppliers about new/reminder purchase orders.
# Leave RESEND_API_KEY unset to run without sending real emails (logs to console instead).
RESEND_API_KEY=
RESEND_FROM_EMAIL=MedTrack Pro <onboarding@resend.dev>
SUPPLIER_PORTAL_URL=http://localhost:5173/supplier/login
